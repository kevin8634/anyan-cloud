{
  "name": "lux3d-web-pipeline",
  "version": "0.1.0",
  "description": "Lux3D (Aholo) → 减面 / 贴图压缩 / 高清武器 / 绑骨 → three.js 网页游戏：从一句话到浏览器里能拿在手上的 3D 道具",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lux3d": "bin/lux3d.mjs"
  },
  "scripts": {
    "ping": "node bin/lux3d.mjs ping",
    "test": "node test/dry-run.mjs",
    "viewer": "npx http-server -c-1 . -o examples/viewer.html"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@manycore/aholo-sdk-asset": "^1.3.0",
    "meshoptimizer": "^0.18.1",
    "meshoptimizer-next": "npm:meshoptimizer@^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.170.0"
  }
}